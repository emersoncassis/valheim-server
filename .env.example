# ============================================================
# Copie este arquivo para .env e preencha.
#   cp .env.example .env
# O .env NUNCA vai pro git (está no .gitignore).
# ============================================================

# ---------- SERVIDOR VALHEIM ----------

# Nome que aparece na lista de servidores do jogo.
VALHEIM_SERVER_NAME=Meu Servidor Valheim

# Nome do mundo. Define o arquivo de save (ex: Dedicated.db / Dedicated.fwl).
# Mudar isso cria um mundo NOVO. Não mude sem querer.
VALHEIM_WORLD_NAME=Dedicated

# Senha do servidor. MÍNIMO 5 caracteres e não pode conter o nome do servidor
# nem o nome do mundo — o Valheim recusa subir se violar isso.
VALHEIM_SERVER_PASS=trocar-esta-senha

# Porta UDP base. O servidor usa PORT, PORT+1 e PORT+2.
VALHEIM_PORT=2456

# Aparecer na lista pública de servidores (true/false).
VALHEIM_PUBLIC=false

# Crossplay (PlayFab) — permite Xbox/Game Pass entrar. true/false.
VALHEIM_CROSSPLAY=false

# SteamIDs de admins, separados por espaço. Opcional.
VALHEIM_ADMIN_IDS=

# Fuso horário do container.
TZ=America/Sao_Paulo


# ---------- BACKUP ----------

# Intervalo entre backups automáticos, em horas.
BACKUP_INTERVAL_HOURS=6

# Quantos backups manter. Os mais antigos são apagados na rotação.
BACKUP_KEEP=14

# Idade máxima de um backup, em dias. 0 = sem limite de idade.
BACKUP_MAX_AGE_DAYS=30


# ---------- PAINEL WEB ----------

# Porta do painel.
PANEL_PORT=8080

# Usuário do painel.
PANEL_USER=admin

# Senha do painel. TROQUE. Mínimo 8 caracteres.
PANEL_PASS=trocar-esta-senha-tambem

# Segredo para assinar o cookie de sessão.
# Gere um aleatório:  openssl rand -hex 32
PANEL_SESSION_SECRET=gere-um-hex-aleatorio-de-64-caracteres

# Duração da sessão, em horas.
PANEL_SESSION_HOURS=12

# Nome do container do Valheim (o painel controla ele via docker).
VALHEIM_CONTAINER=valheim-server

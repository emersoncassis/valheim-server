# Segredos — NUNCA commitar
.env
.env.local
*.env
!.env.example

# Dados do servidor (mundo, saves, configs gerados)
data/
backups/
logs/

# Mundos soltos na raiz. Acontece quando alguém roda o servidor de dentro
# da pasta do repositório: ele cria o mundo e os arquivos de config aqui.
# Save de mundo NUNCA vai pro git — é pesado, muda a cada save e é seu.
ICELAND/
worlds_local/
*.chunk
*.db2
*.fwl2

# Mundos empacotados deixados na raiz pra importar (setup.ps1 -MundoOrigem).
# Sem isso, um zip de 13 MB do save vai parar no repositório.
*.zip
*.tar.gz
*.7z

# Arquivos que o servidor dedicado gera sozinho
adminlist.txt
bannedlist.txt
permittedlist.txt
steam_appid.txt
start_server.sh
docker_start_server.sh
*.pdf

# Node
node_modules/
npm-debug.log*
.npm/

